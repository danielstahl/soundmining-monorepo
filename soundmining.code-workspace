{
  "folders": [
    {
      "name": "root",
      "path": "."
    },
    {
      "name": "libraries",
      "path": "lib"
    },
    {
      "name": "projects",
      "path": "projects"
    },
    {
      "name": "docs",
      "path": "docs"
    }
  ],
  "settings": {
    "workbench.colorTheme":"Dark Modern",
    // Tell VS Code to use the uv-managed virtual environment
    //"python.defaultInterpreterPath": "./.venv/bin/python",
    "python.defaultInterpreterPath": "${workspaceFolder:root}/.venv/bin/python",
    
    "jupyter.askForKernelRestart": false, 
    "notebook.formatOnSave.enabled": true,
     
    "python.testing.pytestEnabled": true,
		"python.testing.unittestEnabled": false,
		"python.testing.pytestArgs": [
			"lib/soundmining-library"
		],
    "python.terminal.activateEnvInCurrentTerminal": true,

    // Use Ruff for everything (Formatting & Linting)
    "python.analysis.extraPaths": [
			"./lib/soundmining-library/src"
		],
    "python.analysis.typeCheckingMode": "basic",
    "editor.fontFamily": "'JetBrains Mono', Fira Code, Inconsolata , Menlo, Monaco, 'Courier New'",
    "editor.fontLigatures": true,
    "editor.fontSize": 13,
    "editor.lineHeight": 1.5,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "always",
      "source.organizeImports.ruff": "always"
    },
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', Fira Code, Inconsolata , Menlo, Monaco, 'Courier New'",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.minimumContrastRatio": 1,
    "terminal.integrated.drawBoldTextInBrightColors": false,
    // TOML configuration for your pyproject files
    "evenBetterToml.formatter.columnWidth": 88,
    
    // Clean up the sidebar (Hide junk)
    "files.exclude": {
      "**/.git": true,
      "**/.DS_Store": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/*.pyc": true
    },

    // Ruff    
    "ruff.lint.enable": true,
    "ruff.organizeImports": true,
    "ruff.nativeServer": "on",
    
    // --- SuperCollider Integration ---
    // Ensure this matches the path in your config.yaml
    "supercollider.sclangCmd": "/Applications/SuperCollider/SuperCollider.app/Contents/MacOS/sclang",    

    // --- File Associations for your Scores ---
    "files.associations": {
      "*.scscore": "supercollider",
      "*.txt": "supercollider",
      "*.scd": "supercollider",
      "*.yaml": "yaml",
      "*.rpp": "xml" 
    },

    "yaml.schemas": {
      "https://squidfunk.github.io/mkdocs-material/schema.json": "mkdocs.yml"
    },
    "yaml.customTags": [ 
      "!ENV scalar",
      "!ENV sequence",
      "!relative scalar",
      "tag:yaml.org,2002:python/name:material.extensions.emoji.to_svg",
      "tag:yaml.org,2002:python/name:material.extensions.emoji.twemoji",
      "tag:yaml.org,2002:python/name:pymdownx.superfences.fence_code_format",
      "tag:yaml.org,2002:python/object/apply:pymdownx.slugs.slugify mapping"
    ],
    "terminal.integrated.defaultProfile.osx": "fish",
    "terminal.integrated.profiles.osx": {
      "fish": {
        "path": "/opt/homebrew/bin/fish"
      }
    },
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "charliermarsh.ruff",
      "tamasfe.even-better-toml",
      "mechatroner.rainbow-csv",
      "tonytony.supercollider",
      "ms-toolsai.jupyter",
      "redhat.vscode-yaml",
    ]
  }
}